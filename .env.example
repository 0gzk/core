# Network selection. Use "testnet" (Galileo) for development and "mainnet" for production.
OG_NETWORK=testnet

# Required to publish (uploads cost gas). Get testnet 0G from https://faucet.0g.ai.
# 0x-prefixed 32-byte hex string. NEVER commit this file.
OG_PRIVATE_KEY=0xreplace_with_a_funded_galileo_testnet_key

# Optional overrides. Defaults are baked into packages/core/src/config.ts.
# OG_RPC_URL=https://evmrpc-testnet.0g.ai
# OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
